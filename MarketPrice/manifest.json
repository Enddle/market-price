{
  "manifest_version": 3,
  "name": "Market Price",
  "version": "1.14.4",
  "description": "Everything come with a price, specifically, at the market price.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://finnhub.io/*",
    "wss://ws.finnhub.io/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}